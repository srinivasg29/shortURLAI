# --- URL Shortener service ---
# Defaults to a local SQLite file; swap for a real Postgres DSN in production.
DATABASE_URL=sqlite:///./data/shortener.db
BASE_REDIRECT_URL=http://localhost:8000
DEFAULT_ALIAS_LENGTH=7
DEFAULT_EXPIRY_DAYS=

# Redis DSN. When unset, app/cache.py falls back to an in-process TTL cache
# (fine for local dev/tests, not for multi-instance deployments).
REDIS_URL=

# --- Orchestrator / agentic layer ---
# When unset, orchestrator/llm.py falls back to deterministic mock responses
# and marks state["llm_mode"] = "mock" in the audit trail.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Skip interactive y/n prompts at Gates 2/5/6 (used by CI and scenario scripts).
AUTO_APPROVE=0

AUDIT_LOG_PATH=./audit_log.jsonl
